{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--goals",
        "data\\nutritions_goals.json",
        "--meals",
        "data\\meal.json",
        "--create_excel",
        "True"
      ]
    }
  ]
}
